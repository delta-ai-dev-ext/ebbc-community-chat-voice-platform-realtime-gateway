# Local development configuration for realtime_gateway.
# Copy to .env for `make run` (godotenv is used locally only; production reads plain env).
# Never commit real secrets: INTERNAL_SERVICE_TOKEN and key material are injected by the
# deployment.

PORT=8080

# Comma separated Kafka bootstrap brokers of the five consumed topics.
KAFKA_BROKERS=localhost:9092
# Optional SASL/TLS (leave unset for a plaintext local broker).
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USER=
# KAFKA_SASL_PASSWORD=
# KAFKA_TLS_ENABLED=false

# messaging_service base URL used for the API-003 scopes call.
MESSAGING_SERVICE_URL=http://localhost:8081
# Per-edge service token sent as `Authorization: Bearer` on API-003.
INTERNAL_SERVICE_TOKEN=local-internal-service-token

# identity_service verification keys: either an inline JWKS document / JWKS file path, or
# PEM files for the current and next (rotation) key. Never fetched at request time.
# IDENTITY_JWKS={"keys":[]}
IDENTITY_PUBLIC_KEY_PATH=./secrets/identity_current.pem
IDENTITY_NEXT_PUBLIC_KEY_PATH=./secrets/identity_next.pem
IDENTITY_TOKEN_ISSUER=identity_service
IDENTITY_TOKEN_AUDIENCE=realtime_gateway

# Origin allow-list for the WebSocket upgrade ("*" allows every origin; never use "*" in
# production). Comma separated absolute http(s) origins.
WS_ALLOWED_ORIGINS=http://localhost:3000

# Optional tuning (seconds unless a Go duration such as 30s is supplied).
WS_HEARTBEAT_INTERVAL=25
WS_READ_DEADLINE=60
WS_SEND_BUFFER_SIZE=64
EVENT_DEDUPE_TTL=600
SHUTDOWN_TIMEOUT=20
